# Copy this file to server/.env and fill in your own values.
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=drivease_app
DB_PASSWORD=CHANGE_ME
DB_NAME=drivease_db

CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Optional: set a long random secret to keep login sessions valid across server restarts.
SESSION_SECRET=replace_with_a_long_random_secret
